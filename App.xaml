<Application x:Class="Player.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- строго ч/б: только оттенки серого -->
    <SolidColorBrush x:Key="Bg" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="Side" Color="#0E0E0E"/>
    <SolidColorBrush x:Key="Bar" Color="#0E0E0E"/>
    <SolidColorBrush x:Key="Line" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Hover" Color="#161616"/>
    <SolidColorBrush x:Key="Sel" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Fg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Dim" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="Faint" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Track" Color="#2A2A2A"/>
    <!-- цветовые кисти; при запуске NoirTheme.Init заменяет их изменяемыми и красит по выбранному режиму -->
    <SolidColorBrush x:Key="Accent" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#40F2F2F2"/>
    <SolidColorBrush x:Key="SideGlass" Color="#B80A0A0A"/>
    <SolidColorBrush x:Key="BarGlass" Color="#E00A0A0A"/>
    <SolidColorBrush x:Key="PanelBg" Color="#F50E0E0E"/>
    <SolidColorBrush x:Key="MenuBg" Color="#181818"/>
    <SolidColorBrush x:Key="Tile" Color="#141414"/>
    <LinearGradientBrush x:Key="Shade" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#B80A0A0A" Offset="0"/>
      <GradientStop Color="#DA0A0A0A" Offset="0.55"/>
      <GradientStop Color="#F80A0A0A" Offset="1"/>
    </LinearGradientBrush>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- кнопка-иконка -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="18">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                <Setter TargetName="B" Property="Background" Value="#1AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#2AFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- большая белая круглая кнопка Play -->
    <Style x:Key="PlayBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
      <!-- без ClearType: на белом круге он давал цветную кайму у значка -->
      <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{DynamicResource Accent}" CornerRadius="100">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.9"/>
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.05" ScaleY="1.05"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- кнопка-«пилюля» (Слушать, Перемешать, фильтры волны) -->
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <!-- полупрозрачные: видны и на тёмном, и на светлом размытом фоне обложки -->
      <Setter Property="Background" Value="#14FFFFFF"/>
      <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="17" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#26FFFFFF"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#55FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PillOn" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- пункт бокового меню -->
    <!-- тумблер для настроек -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="T" Width="42" Height="24" CornerRadius="12" Background="#26FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
              <Ellipse x:Name="K" Width="16" Height="16" Fill="{DynamicResource Fg}" HorizontalAlignment="Left" Margin="3,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="T" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="T" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="K" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="K" Property="Fill" Value="{DynamicResource OnAccent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="Opacity" Value="0.88"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavBtn" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="12,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                <Setter TargetName="B" Property="Background" Value="#10FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                <Setter TargetName="B" Property="Background" Value="#1CFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- тонкий ползунок: перемотка и громкость -->
    <Style x:Key="FillBtn" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent"><Border Height="3" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Center"/></Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EmptyBtn" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Knob" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb"><Ellipse Width="11" Height="11" Fill="{DynamicResource Fg}"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Thin" TargetType="Slider">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="16" Background="Transparent">
              <Border Height="3" CornerRadius="1.5" Background="{DynamicResource Track}" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource FillBtn}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource EmptyBtn}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb x:Name="K" Style="{StaticResource Knob}" Opacity="0"/></Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="K" Property="Opacity" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- тонкий скроллбар -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#2E2E2E" Margin="2,0"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- строки списка без синей системной подсветки -->
    <Style x:Key="Row" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="B" Background="Transparent" CornerRadius="8" Height="54" Padding="10,0">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#12FFFFFF"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#1CFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ссылка: имя артиста, название альбома -->
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="C" RecognizesAccessKey="False"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- плитка: альбом, артист, плейлист -->
    <Style x:Key="CardBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="12" Padding="10">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#12FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#1CFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- контекстное меню в тон плееру -->
    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{DynamicResource MenuBg}" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="5" Margin="0,0,14,14" MinWidth="220">
              <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.6" Color="Black"/></Border.Effect>
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="10,7">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Width="26" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Dim}"/>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="#22FFFFFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator"><Border Height="1" Background="#22FFFFFF" Margin="8,4"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <BooleanToVisibilityConverter x:Key="Vis"/>
  </Application.Resources>
</Application>
